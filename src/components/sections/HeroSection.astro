---
interface Props {
  fullName: string;
  professionalTitle: string;
}

const { fullName, professionalTitle } = Astro.props;
---

<section class="hero">
  <h1 class="hero__name">{fullName}</h1>
  <p class="hero__title">{professionalTitle}</p>
</section>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(3rem, 8vh, 6rem) var(--space-8) var(--space-16);
    background-color: var(--color-hero-bg);
  }

  .hero__name {
    font-size: var(--font-size-hero-name);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin: 0;
    border-bottom: 0.06em solid var(--color-text-primary);
    padding-bottom: 0.1em;
    display: inline-block;
  }

  .hero__title {
    font-size: var(--font-size-hero-title);
    font-weight: 400;
    color: var(--color-text-secondary);
    margin: var(--space-8) 0 0;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  @media (max-width: 767px) {
    .hero {
      padding: clamp(2rem, 6vh, 4rem) var(--space-4) var(--space-8);
    }
  }
</style>
